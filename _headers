# Intestazioni per Cloudflare Pages (stesse regole di netlify.toml).
# L'HTML resta sulla cache predefinita di Pages, cosi' un nuovo deploy si vede subito.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Sequenze di fotogrammi e font: non cambiano mai (rigenerandole si cambia cartella), cache lunga
/img/journey-2/*
  Cache-Control: public, max-age=31536000, immutable

/img/esterni-2/*
  Cache-Control: public, max-age=31536000, immutable

/font/*
  Cache-Control: public, max-age=31536000, immutable

# Realta' aumentata: iPhone apre AR Quick Look solo se il file USDZ arriva con il suo tipo (con nosniff non lo indovina)
/*.usdz
  Content-Type: model/vnd.usdz+zip

/*.glb
  Content-Type: model/gltf-binary

# Area cliente Casa Traversa: preventivo e rilievo fuori dai motori di ricerca, anche i PDF e i file del 3D
/area-ct26/*
  X-Robots-Tag: noindex, nofollow

# Presentazione dei servizi (pagina e PDF da inviare): non collegata al sito, fuori dai motori di ricerca
/presentazione/*
  X-Robots-Tag: noindex, nofollow

# Area cliente progetto Mario: modello 3D e rilievo fuori dai motori di ricerca
/area-mr26/*
  X-Robots-Tag: noindex, nofollow

# Demo per pizzerie (/pizza/): fuori dai motori di ricerca; i font non cambiano mai
/pizza/*
  X-Robots-Tag: noindex, nofollow

/pizza/font/*
  Cache-Control: public, max-age=31536000, immutable
