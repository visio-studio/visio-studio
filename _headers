# Intestazioni per Cloudflare Pages (stesse regole di netlify.toml).
# L'HTML resta sulla cache predefinita di Pages, cosi' un nuovo deploy si vede subito.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Sequenze di fotogrammi e font: non cambiano mai (rigenerandole si cambia cartella), cache lunga
/img/journey-2/*
  Cache-Control: public, max-age=31536000, immutable

/img/esterni-2/*
  Cache-Control: public, max-age=31536000, immutable

/font/*
  Cache-Control: public, max-age=31536000, immutable

# Realta' aumentata: iPhone apre AR Quick Look solo se il file USDZ arriva con il suo tipo (con nosniff non lo indovina)
/*.usdz
  Content-Type: model/vnd.usdz+zip

/*.glb
  Content-Type: model/gltf-binary
